 TERMUX_PKG_BUILD_IN_SRC=true
+
+# LDFA: upstream's v0.4 tarball ships no LICENSE file, and termux-licenses has no
+# generic "BSD 2-Clause" template, so termux_step_install_license aborts the build
+# (only hit when apt's dep chain is built, i.e. a non---android10 bootstrap). The
+# BSD-2-Clause text lives in the source headers; skip the copyright-file install for
+# this one package so the bootstrap can build. No functional impact.
+termux_step_install_license() {
+	mkdir -p "${TERMUX_PREFIX}/share/doc/${TERMUX_PKG_NAME}"
+	printf '%s\n' "$TERMUX_PKG_LICENSE" > "${TERMUX_PREFIX}/share/doc/${TERMUX_PKG_NAME}/copyright"
+}
