diff --git a/packages/libandroid-utimes/build.sh b/packages/libandroid-utimes/build.sh
index 07647fd..a5e39e5 100644
--- a/packages/libandroid-utimes/build.sh
+++ b/packages/libandroid-utimes/build.sh
@@ -6,3 +6,13 @@ TERMUX_PKG_VERSION=0.4
 TERMUX_PKG_SRCURL=https://github.com/termux/libandroid-utimes/archive/refs/tags/v${TERMUX_PKG_VERSION}.tar.gz
