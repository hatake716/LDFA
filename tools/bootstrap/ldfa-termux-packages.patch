-						termux_error_exit "${TERMUX_PKG_NAME}: Could not find a license file for $LICENSE in packages/termux-licenses"
+						# LDFA: no generic template for this SPDX id — warn + stub instead of abort.
+						echo "WARNING (LDFA): ${TERMUX_PKG_NAME}: no template for $LICENSE in termux-licenses; writing a stub." 1>&2
+						mkdir -p "${TERMUX_PREFIX}/share/doc/${TERMUX_PKG_NAME}"
+						printf '%s\n' "$TERMUX_PKG_LICENSE" > "${TERMUX_PREFIX}/share/doc/${TERMUX_PKG_NAME}/copyright"
+						continue
 					}
 					# the link target depends on the libc being used
 					case "$TERMUX_PACKAGE_LIBRARY" in
