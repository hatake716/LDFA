diff --git a/scripts/build-bootstraps.sh b/scripts/build-bootstraps.sh
index 53bb59d..ac54a69 100755
--- a/scripts/build-bootstraps.sh
+++ b/scripts/build-bootstraps.sh
@@ -116,6 +116,53 @@ extract_debs() {
 		echo "\""
 	fi
 
+	# LDFA: extract_debs globs the WHOLE output/ dir. With a custom package name the build
+	# runs in all-source mode (TERMUX_INSTALL_DEPS=false = "don't download, build from
+	# source"), so apt's full BUILD-dependency closure (python, tcl, tk, doxygen, perl,
+	# tor, swig, the X11 stack, ...) gets compiled into the SAME output/ dir and would be
+	# swept into the bootstrap — 164 pkgs / 144MB instead of the intended 79 runtime set.
+	# The upstream bootstrap gets exactly 79 because it DOWNLOADS deps as prebuilt debs, so
+	# build-only deps never touch its output/. We can't do that (wrong prefix), so restrict
+	# extraction to the intended RUNTIME package set (the 79 the current shipped bootstrap
+	# has). This is the runtime closure; build-only tooling is correctly excluded.
+	local -A LDFA_BOOTSTRAP_WHITELIST=()
+	local _wp
+	for _wp in \
+		apt attr bash bzip2 ca-certificates command-not-found coreutils curl dash \
+		debianutils dialog diffutils dos2unix dpkg ed findutils gawk gpgv grep gzip \
+		inetutils less libacl libandroid-glob libandroid-posix-semaphore \
+		libandroid-selinux libandroid-support libassuan libbz2 libc++ libcap-ng libcurl \
+		libevent libgcrypt libgmp libgnutls libgpg-error libiconv libidn2 liblz4 liblzma \
+		libmd libmpfr libnettle libnghttp2 libnghttp3 libngtcp2 libnpth libsmartcols \
+		libssh2 libtirpc libunbound libunistring lsof nano ncurses net-tools openssl \
+		patch pcre2 procps psmisc readline resolv-conf sed tar termux-am termux-am-socket \
+		termux-core termux-exec termux-keyring termux-licenses termux-tools unzip \
+		util-linux xxhash xz-utils zlib zstd \
+		p11-kit libtasn1 libffi \
+		libmount libblkid libmagic \
+		proot proot-distro tmux pulseaudio xkeyboard-config \
+		dbus python python-pip \
+		libtalloc libandroid-shmem libandroid-stub libandroid-execinfo \
+		libx11 libxcb libxau libxdmcp xorgproto xorg-util-macros \
+		libsqlite gdbm libcrypt libexpat libltdl \
+		libsndfile libsoxr speexdsp libwebrtc-audio-processing abseil-cpp \
+		libflac libvorbis libogg libopus libmp3lame libmpg123 \
+		ncurses-ui-libs; do
+		LDFA_BOOTSTRAP_WHITELIST["$_wp"]=1
+	done
+	# NOTE: these are NOT in the upstream vendor 79 set, but OUR source-built libs have
+	# different NEEDED than the upstream prebuilts (termux-packages version drift):
+	#  - libgnutls.so NEEDs libp11-kit.so/libtasn1.so → add p11-kit (→libp11-kit.so, also
+	#    NEEDs libffi.so+libtasn1.so) + libtasn1 + libffi. Without these apt's https method
+	#    won't link ("libp11-kit.so not found") and `pkg update` dies (seen on-device).
+	#  - bin/lsns NEEDs libmount.so, bin/nano NEEDs libmagic.so → add libmount (util-linux
+	#    subpackage, NEEDs libblkid.so → add libblkid) + libmagic (file subpackage). All
+	#    their other NEEDED (libandroid-posix-semaphore/lzma/bz2/z/zstd) are already in.
+	# A readelf-d completeness sweep over the zip (scratchpad/check-bootstrap-deps.sh) is
+	# the right verify; the only remaining "misses" it reports are pylibmount.so (a python
+	# binding) and *-fsanitize test binaries under libexec/installed-tests — those are
+	# inert (present in the upstream vendor zip too, never executed) and can be ignored.
+
 	for deb in *.deb; do
 
 		current_package_name="$(echo "$deb" | sed -E 's/^([^_]+).*/\1/' )"
@@ -133,6 +180,12 @@ extract_debs() {
 			continue
 		fi
 
+		# LDFA: skip anything outside the intended runtime bootstrap set.
+		if [[ -z "${LDFA_BOOTSTRAP_WHITELIST[$current_package_name]:-}" ]]; then
+			echo "[*] LDFA: skipping non-bootstrap package '$current_package_name'..."
+			continue
+		fi
+
 		if [[ " ${EXTRACTED_PACKAGES[*]} " == *" $current_package_name "* ]]; then
 			echo "[*] Skipping already extracted package '$current_package_name'..."
 			continue
@@ -429,7 +482,7 @@ main() {
 
 		# Core utilities.
 		PACKAGES+=("bash") # Used by `termux-bootstrap-second-stage.sh`
-		PACKAGES+=("bzip2")
+		PACKAGES+=("libbz2") # LDFA: was "bzip2" (a subpackage of libbz2); build-package.sh cannot build a subpackage name, but building libbz2 emits the bzip2 .deb which extract_debs picks up
 		if ! ${BOOTSTRAP_ANDROID10_COMPATIBLE}; then
 			PACKAGES+=("command-not-found")
 		else
