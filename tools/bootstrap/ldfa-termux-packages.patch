+	# prefix/package are substituted everywhere.
+	export TERMUX_PREFIX=${TERMUX_PREFIX}
+	export TERMUX_APP_PACKAGE=${TERMUX_APP_PACKAGE}
 
 	# Explicitly export in case the default was set.
 	export TERMUX_ARCH=${TERMUX_ARCH}
